PORT=3000
NODE_ENV=development
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog_password
POSTGRES_DB=blog
DATABASE_URL=postgresql://blog:blog_password@localhost:5432/blog
JWT_ACCESS_SECRET=замените_на_длинную_случайную_строку
JWT_REFRESH_SECRET=замените_на_другую_длинную_случайную_строку
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=bull
REMINDER_DELAY_MS=86400000
TRUST_PROXY=false
