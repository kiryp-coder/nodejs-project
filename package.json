{
  "name": "nodejs-project",
  "version": "1.0.0",
  "description": "Node.js, КТ 2–6",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "prisma migrate deploy && node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "db:up": "docker compose up -d db redis",
    "migrate": "prisma migrate dev",
    "seed": "prisma db seed",
    "studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@bull-board/api": "^9.13.0",
    "@bull-board/express": "^9.13.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.19.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./__tests__/globalSetup.js",
    "setupFiles": [
      "./__tests__/setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
